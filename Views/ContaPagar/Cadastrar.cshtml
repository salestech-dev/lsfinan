@model lsfinan.ViewModel.ContaPagarViewModel
@{
    var edicao = Model.Id > 0;
    ViewData["Title"] = edicao ? "Editar Conta a Pagar" : "Nova Conta a Pagar";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/contapagar.css" asp-append-version="true" />

<div class="cp-page cp-page-estreita">

    <div class="cp-header">
        <div>
            <span class="cp-label">CONTAS A PAGAR</span>
            <h1>@(edicao ? "Editar conta a pagar" : "Nova conta a pagar")</h1>
            <p>
                @(edicao
                    ? "Altere os dados da conta. Ela só vira uma saída quando você confirmar o pagamento."
                    : "Cadastre uma conta com vencimento para ser lembrado antes de atrasar.")
            </p>
        </div>

        <a asp-action="Index" class="cp-btn-sec">Voltar</a>
    </div>

    <div class="cp-card">

        <form asp-action="@(edicao ? "Editar" : "Cadastrar")"
              asp-route-id="@(edicao ? Model.Id.ToString() : null)"
              method="post">

            <div asp-validation-summary="ModelOnly" class="cp-erro"></div>

            <div class="cp-campo">
                <label asp-for="NomeContaPagar">Nome da conta</label>
                <input asp-for="NomeContaPagar" placeholder="Ex: Aluguel, internet, cartão de crédito..." autocomplete="off" />
                <span asp-validation-for="NomeContaPagar" class="cp-erro-campo"></span>
            </div>

            <div class="cp-linha-2">
                <div class="cp-campo">
                    <label asp-for="ValorContaPagar">Valor</label>
                    <input asp-for="ValorContaPagar" type="number" step="0.01" min="0" placeholder="0,00" />
                    <span asp-validation-for="ValorContaPagar" class="cp-erro-campo"></span>
                </div>

                <div class="cp-campo">
                    <label asp-for="DataVencimento">Vencimento</label>
                    <input asp-for="DataVencimento" type="date" />
                    <span asp-validation-for="DataVencimento" class="cp-erro-campo"></span>
                </div>
            </div>

            <div class="cp-campo">
                <label asp-for="CategoriaId">Categoria</label>
                <select asp-for="CategoriaId">
                    <option value="">Selecione uma categoria</option>
                    @foreach (var categoria in Model.Categorias)
                    {
                        <option value="@categoria.Id">@categoria.NomeCategoria@(categoria.Ativa ? "" : " (inativa)")</option>
                    }
                </select>
                <span asp-validation-for="CategoriaId" class="cp-erro-campo"></span>
            </div>

            <div class="cp-campo">
                <label asp-for="DescricaoContaPagar">Observação (opcional)</label>
                <textarea asp-for="DescricaoContaPagar" rows="3" placeholder="Ex: código de barras, número do contrato..."></textarea>
            </div>

            <div class="cp-dica">
                <span>ℹ</span>
                <div>
                    Você será avisado quando faltarem poucos dias, no dia do vencimento e quando a conta atrasar.
                    Na hora de pagar, você escolhe de qual conta sai o dinheiro (ou divide entre mais de uma).
                </div>
            </div>

            <div class="cp-rodape">
                <a asp-action="Index" class="cp-btn-sec">Cancelar</a>
                <button type="submit" class="cp-btn">@(edicao ? "Salvar alterações" : "Cadastrar conta a pagar")</button>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
