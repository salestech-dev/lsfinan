<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - LS Finan</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>

        html, body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }

        body {
            background: #070b12;
            color: #e5e7eb;
            font-family: "Segoe UI", sans-serif;
        }

        /* =========================
           NAVBAR
           ========================= */

        .ls-navbar {
            height: 72px;
            background: #080d16;
            border-bottom: 1px solid rgba(255,255,255,.06);
            display: flex;
            align-items: center;
        }

        .ls-navbar-container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 30px;

            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* LOGO */

        .ls-logo {
            display: flex;
            align-items: center;
            gap: 12px;

            text-decoration: none;
            color: white;
        }

        .ls-logo-icon {
            width: 42px;
            height: 42px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 11px;

            background: #2563eb;
            color: white;

            font-size: 21px;
            font-weight: 700;

            box-shadow: 0 6px 20px rgba(37,99,235,.25);
        }

        .ls-logo-name {
            font-size: 20px;
            font-weight: 700;
            color: #f8fafc;
        }

        .ls-logo-name span {
            color: #60a5fa;
        }

        /* MENU */

        .ls-nav {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-left: 40px;
            margin-right: auto;
        }

        .ls-nav-link {
            padding: 9px 14px;

            border-radius: 8px;

            color: #94a3b8;
            text-decoration: none;

            font-size: 14px;
            font-weight: 500;

            transition: .2s;
        }

        .ls-nav-link:hover {
            color: white;
            background: rgba(255,255,255,.05);
        }

        .ls-nav-link.active {
            color: #60a5fa;
            background: rgba(37,99,235,.10);
        }

        /* USUÁRIO */

        .ls-user-area {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .ls-account {
            padding: 9px 15px;

            border: 1px solid rgba(59,130,246,.25);
            border-radius: 8px;

            color: #cbd5e1;
            text-decoration: none;

            font-size: 14px;

            transition: .2s;
        }

        .ls-account:hover {
            color: white;
            border-color: #3b82f6;
            background: rgba(37,99,235,.08);
        }

        .ls-logout {
            padding: 9px 16px;

            border: none;
            border-radius: 8px;

            background: #2563eb;
            color: white;

            font-size: 14px;
            font-weight: 600;

            cursor: pointer;

            transition: .2s;
        }

        .ls-logout:hover {
            background: #3b82f6;
        }

        /* CONTEÚDO */

        .ls-main {
            min-height: calc(100vh - 72px);
            padding: 30px;
        }

        .ls-content {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
        }

        /* FOOTER */

        .ls-footer {
            border-top: 1px solid rgba(255,255,255,.05);
            background: #050911;

            padding: 18px 30px;

            color: #64748b;
            font-size: 13px;
        }

        .ls-footer-container {
            max-width: 1400px;
            margin: 0 auto;

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* RESPONSIVO */

        @@media (max-width: 900px) {

            .ls-nav {
                display: none;
            }

            .ls-navbar-container {
                padding: 0 18px;
            }

            .ls-main {
                padding: 20px;
            }
        }

    </style>
</head>

<body>

    <header class="ls-navbar">

        <div class="ls-navbar-container">

            <!-- LOGO -->

            <a class="ls-logo"
               asp-controller="Home"
               asp-action="Index">

                <div class="ls-logo-icon">
                    $
                </div> 

                <div class="ls-logo-name">
                    Wise<span>Wallet</span>
                </div>

            </a>


            <!-- MENU -->

            @if (User.Identity?.IsAuthenticated == true)
            {
                <nav class="ls-nav">

                    <a class="ls-nav-link"
                       asp-controller="Home"
                       asp-action="Index">
                        Início
                    </a>

                    <a class="ls-nav-link"
                       asp-controller="Dashboard"
                       asp-action="Index">
                        Dashboard
                    </a>

                    <a class="ls-nav-link"
                       asp-controller="Conta"
                       asp-action="Index">
                        Contas
                    </a>

                    <a class="ls-nav-link"
                       asp-controller="Entrada"
                       asp-action="Index">
                        Entradas
                    </a>

                    <a class="ls-nav-link"
                       asp-controller="Saida"
                       asp-action="Index">
                        Saídas
                    </a>

                    <a class="ls-nav-link"
                       asp-controller="Categoria"
                       asp-action="Index">
                        Categorias
                    </a>

                </nav>


                <!-- USUÁRIO -->

                <div class="ls-user-area">

                    <a class="ls-account"
                       asp-controller="Usuario"
                       asp-action="Perfil">

                        Minha conta

                    </a>

                    <form asp-controller="Usuario"
                          asp-action="Logout"
                          method="post"
                          style="margin:0;">

                        <button type="submit"
                                class="ls-logout">

                            Sair

                        </button>

                    </form>

                </div>
            }

        </div>

    </header>


    <!-- CONTEÚDO DAS PÁGINAS -->

    <main class="ls-main">

        <div class="ls-content">

            @RenderBody()

        </div>

    </main>


    <!-- FOOTER -->

    <footer class="ls-footer">

        <div class="ls-footer-container">

            <span>
                © 2026 LS Finan
            </span>

            <span>
                Controle financeiro simples e inteligente.
            </span>

            <span>
                Privacidade
            </span>

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>