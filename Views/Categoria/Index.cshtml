@model List<Categoria>

@{
    ViewData["Title"] = "Categorias";
}

<style>

    .categorias-page {
        min-height: 100vh;

        padding: 50px 30px;

        font-family: "Inter", "Segoe UI", Arial, sans-serif;

        color: #0f172a;

        background:
            radial-gradient(
                circle at 15% 20%,
                rgba(15, 37, 71, 0.025),
                transparent 28%
            ),
            radial-gradient(
                circle at 85% 80%,
                rgba(15, 37, 71, 0.02),
                transparent 30%
            ),
            #f4f6f9;
    }


    /* =========================
       CONTAINER
       ========================= */

    .categorias-container {
        max-width: 1000px;

        margin: 0 auto;

        background: #ffffff;

        border: 1px solid #e2e8f0;

        border-radius: 24px;

        padding: 45px 50px;

        box-shadow:
            0 30px 90px rgba(15, 23, 42, 0.138),
            0 0 80px rgba(15, 37, 71, 0.035);
    }


    /* =========================
       HEADER
       ========================= */

    .categorias-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;

        margin-bottom: 35px;

        gap: 20px;

        flex-wrap: wrap;
    }

    .categorias-header h2 {
        margin: 0 0 8px;

        font-size: 28px;
        font-weight: 700;

        letter-spacing: -0.6px;

        color: #0f172a;
    }

    .categorias-header p {
        margin: 0;

        color: #64748b;

        font-size: 14px;

        line-height: 1.6;
    }


    /* =========================
       BOTÃO NOVA CATEGORIA
       ========================= */

    .btn-nova-categoria {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        height: 48px;

        padding: 0 22px;

        border: none;
        border-radius: 11px;

        background: linear-gradient(
            135deg,
            #0f2547,
            #173a73
        );

        color: #ffffff;

        font-size: 14px;
        font-weight: 600;

        text-decoration: none;

        white-space: nowrap;

        cursor: pointer;

        box-shadow:
            0 10px 30px rgba(15, 37, 71, 0.175);

        transition: all 0.25s ease;
    }

    .btn-nova-categoria:hover {
        background: linear-gradient(
            135deg,
            #173a73,
            #0f2547
        );

        color: #ffffff;

        transform: translateY(-2px);

        box-shadow:
            0 15px 35px rgba(15, 37, 71, 0.245);
    }


    /* =========================
       TABELA
       ========================= */

    .categorias-table-wrapper {
        border: 1px solid #e2e8f0;

        border-radius: 16px;

        overflow: hidden;
    }

    table.categorias-table {
        width: 100%;

        border-collapse: collapse;
    }

    .categorias-table thead th {
        text-align: left;

        padding: 16px 20px;

        background: #f8fafc;

        color: #64748b;

        font-size: 12px;
        font-weight: 600;

        text-transform: uppercase;

        letter-spacing: 0.5px;

        border-bottom: 1px solid #e2e8f0;
    }

    .categorias-table tbody td {
        padding: 18px 20px;

        font-size: 14px;

        color: #1e293b;

        border-bottom: 1px solid #e2e8f0;
    }

    .categorias-table tbody tr:last-child td {
        border-bottom: none;
    }

    .categorias-table tbody tr {
        background: #ffffff;

        transition: background 0.2s ease;
    }

    .categorias-table tbody tr:hover {
        background: #f8fafc;
    }


    /* =========================
       STATUS
       ========================= */

    .status-badge {
        display: inline-flex;
        align-items: center;

        gap: 7px;

        padding: 5px 12px;

        border-radius: 20px;

        font-size: 12px;
        font-weight: 600;
    }

    .status-badge.ativa {
        background: #f0fdf4;

        border: 1px solid #bbf7d0;

        color: #15803d;
    }

    .status-badge.inativa {
        background: #fef2f2;

        border: 1px solid #fecaca;

        color: #b91c1c;
    }

    .status-dot {
        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: currentColor;
    }


    /* =========================
       AÇÕES
       ========================= */

    .acoes-cell {
        display: flex;

        gap: 10px;
    }

    .btn-acao {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        height: 34px;

        padding: 0 14px;

        border-radius: 8px;

        font-size: 13px;
        font-weight: 600;

        text-decoration: none;

        cursor: pointer;

        transition: all 0.2s ease;

        border: 1px solid transparent;
    }

    .btn-editar {
        background: #e8edf6;

        border-color: #d3dcec;

        color: #1d4380;
    }

    .btn-editar:hover {
        background: #d3dcec;

        color: #0f2547;
    }

    .btn-excluir {
        background: transparent;

        border-color: #fecaca;

        color: #dc2626;
    }

    .btn-excluir:hover {
        background: #fef2f2;

        color: #b91c1c;
    }


    /* =========================
       ESTADO VAZIO
       ========================= */

    .categorias-vazio {
        padding: 60px 20px;

        text-align: center;

        color: #64748b;

        font-size: 14px;
    }

    .categorias-vazio strong {
        display: block;

        margin-bottom: 8px;

        color: #334155;

        font-size: 16px;
    }


    /* =========================
       RESPONSIVO
       ========================= */

    @@media (max-width: 700px) {

        .categorias-page {
            padding: 25px 15px;
        }

        .categorias-container {
            padding: 30px 22px;
        }

        .categorias-table thead {
            display: none;
        }

        .categorias-table,
        .categorias-table tbody,
        .categorias-table tr,
        .categorias-table td {
            display: block;

            width: 100%;
        }

        .categorias-table tbody tr {
            padding: 16px 18px;

            margin-bottom: 12px;

            border: 1px solid #e2e8f0;

            border-radius: 12px;
        }

        .categorias-table tbody td {
            border-bottom: none;

            padding: 6px 0;
        }

        .categorias-table tbody td::before {
            content: attr(data-label);

            display: block;

            font-size: 11px;

            font-weight: 600;

            color: #64748b;

            text-transform: uppercase;

            margin-bottom: 4px;
        }

        .acoes-cell {
            margin-top: 8px;
        }
    }

    /* botões de ação que são <button> dentro de formulário (excluir) */
    .form-inline-acao {
        display: inline;
        margin: 0;
    }

    button.btn-acao {
        font-family: inherit;
        cursor: pointer;
    }
</style>


<div class="categorias-page">

    <div class="categorias-container">

        <div class="categorias-header">

            <div>
                <h2>Categorias</h2>
                <p>Organize suas entradas e saídas por categoria.</p>
            </div>

            <a asp-action="CadastrarCategoria" class="btn-nova-categoria">
                Nova categoria
            </a>

        </div>


        <div class="categorias-table-wrapper">

            @if (Model != null && Model.Count > 0)
            {
                <table class="categorias-table">

                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var categoria in Model)
                        {
                            <tr>
                                <td data-label="Nome">@categoria.NomeCategoria</td>

                                <td data-label="Status">
                                    @if (categoria.Ativa)
                                    {
                                        <span class="status-badge ativa">
                                            <span class="status-dot"></span>
                                            Ativa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge inativa">
                                            <span class="status-dot"></span>
                                            Inativa
                                        </span>
                                    }
                                </td>

                                <td data-label="Ações">
                                    <div class="acoes-cell">
                                        <a asp-action="Editar"
                                           asp-route-id="@categoria.Id"
                                           class="btn-acao btn-editar">
                                            Editar
                                        </a>

                                        <form asp-action="Excluir"
                                              asp-route-id="@categoria.Id"
                                              method="post"
                                              class="form-inline-acao"
                                              data-confirmar="Excluir a categoria &quot;@categoria.NomeCategoria&quot;? Isso não pode ser desfeito."
                                              onsubmit="return confirm(this.dataset.confirmar)">
                                            <button type="submit" class="btn-acao btn-excluir">
                                                Excluir
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            }
            else
            {
                <div class="categorias-vazio">
                    <strong>Nenhuma categoria cadastrada</strong>
                    Clique em "Nova categoria" para criar a primeira.
                </div>
            }

        </div>

    </div>

</div>
