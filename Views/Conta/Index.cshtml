@model List<lsfinan.ViewModel.ContaListagemViewModel>
@{
    ViewData["Title"] = "Minhas Contas";
    Layout = "_Layout";
}

<style>
    .conta-page {
        padding: 30px;
        color: #0f172a;
    }

    .conta-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .conta-header h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
    }

    .conta-header p {
        margin-top: 6px;
        color: #64748b;
    }

    .btn-primary {
        background: #0f2547;
        color: #ffffff;
        text-decoration: none;
        padding: 12px 20px;
        border-radius: 10px;
        font-weight: 600;
        transition: 0.2s;
    }

    .btn-primary:hover {
        background: #173a73;
    }

    .contas-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
    }

    .conta-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 22px;
        transition: 0.2s;
    }

    .conta-card:hover {
        border-color: #1d4380;
        transform: translateY(-2px);
    }

    .conta-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: rgba(15, 37, 71, 0.135);
        color: #1d4380;
        font-size: 20px;
        margin-bottom: 18px;
    }

    .conta-nome {
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .conta-tipo {
        color: #64748b;
        font-size: 14px;
        margin-bottom: 18px;
    }

    .conta-saldo-label {
        color: #64748b;
        font-size: 13px;
        margin-bottom: 4px;
    }

    .conta-saldo {
        font-size: 24px;
        font-weight: 700;
        color: #1d4380;
    }

    .empty-state {
        background: #ffffff;
        border: 1px dashed #cbd5e1;
        border-radius: 16px;
        padding: 60px 20px;
        text-align: center;
        color: #64748b;
    }

    .empty-state h2 {
        color: #0f172a;
        margin-bottom: 10px;
    }

    .empty-state p {
        margin-bottom: 25px;
    }

    @@media (max-width: 700px) {
        .conta-page {
            padding: 20px;
        }

        .conta-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }
    }

    .toast-conta {
        position: fixed;
        right: 25px;
        bottom: 25px;

        display: flex;
        align-items: center;
        gap: 14px;

        min-width: 300px;
        max-width: 380px;

        padding: 16px 20px;

        background: #ffffff;
        border: 1px solid #1d4380;
        border-radius: 14px;

        color: #0f172a;

        box-shadow:
            0 10px 35px rgba(15, 23, 42, 0.113),
            0 0 25px rgba(15, 37, 71, 0.126);

        z-index: 9999;

        animation:
            toastEntrada 0.5s ease-out,
            toastSaida 0.5s ease-in 3.5s forwards;
    }

    .toast-icon {
        width: 40px;
        height: 40px;

        display: flex;
        align-items: center;
        justify-content: center;

        background: #0f2547;
        border-radius: 50%;

        font-size: 20px;
        font-weight: bold;

        box-shadow: 0 0 18px rgba(15, 37, 71, 0.35);
    }

    .toast-content {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .toast-content strong {
        font-size: 15px;
    }

    .toast-content span {
        color: #64748b;
        font-size: 13px;
    }

    @@keyframes toastEntrada {

        0% {
            opacity: 0;
            transform: translateY(80px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes toastSaida {

        0% {
            opacity: 1;
            transform: translateY(0);
        }

        100% {
            opacity: 0;
            transform: translateY(30px);
        }
    }

    .contas-total {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        padding: 16px 20px;
        margin-bottom: 20px;
        background: #0f2547;
        border-radius: 16px;
        color: #cbd5e1;
    }

    .contas-total span { font-size: 14px; }

    .contas-total strong { font-size: 24px; color: #ffffff; }

    .contas-total strong.negativo { color: #fca5a5; }

    .conta-saldo.negativo { color: #dc2626; }

    .conta-inativa { opacity: .65; }

    .conta-badge-inativa {
        display: inline-block;
        margin-left: 6px;
        padding: 2px 8px;
        border-radius: 999px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
        font-size: 11px;
        font-weight: 600;
    }

    .conta-editar {
        display: inline-block;
        margin-top: 14px;
        color: #1d4380;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

    .conta-editar:hover { text-decoration: underline; }
</style>

<div class="conta-page">

    <div class="conta-header">
        <div>
            <h1>Minhas Contas</h1>
            <p>Gerencie suas contas e acompanhe seus saldos.</p>
        </div>

        <a asp-action="CadastrarConta" class="btn-primary">
            + Nova conta
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        var totalAtivas = Model.Where(c => c.Ativa).Sum(c => c.SaldoAtual);

        <div class="contas-total">
            <span>Saldo total das contas ativas</span>
            <strong class="@(totalAtivas < 0 ? "negativo" : "")">@totalAtivas.ToString("C2")</strong>
        </div>

        <div class="contas-grid">
            @foreach (var conta in Model)
            {
                <div class="conta-card @(conta.Ativa ? "" : "conta-inativa")">

                    <div class="conta-icon">
                        $
                    </div>

                    <div class="conta-nome">
                        @conta.NomeConta
                    </div>

                    <div class="conta-tipo">
                        @conta.TipoConta
                        @if (!conta.Ativa)
                        {
                            <span class="conta-badge-inativa">Inativa</span>
                        }
                    </div>

                    <div class="conta-saldo-label">
                        Saldo Conta
                    </div>

                    <div class="conta-saldo @(conta.SaldoAtual < 0 ? "negativo" : "")">
                        @conta.SaldoAtual.ToString("C2")
                    </div>

                    <a asp-action="EditarConta"
                       asp-route-id="@conta.Id"
                       class="conta-editar">
                        Editar
                    </a>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-state">

            <h2>Nenhuma conta cadastrada</h2>

            <p>
                Cadastre sua primeira conta para começar a organizar suas finanças.
            </p>

            <a asp-action="CadastrarConta" class="btn-primary">
                Cadastrar minha primeira conta
            </a>

        </div>
    }

</div>

@if (TempData["ContaCriada"] != null)
{
    <div id="toastConta" class="toast-conta">
        <div class="toast-icon">
            ✓
        </div>

        <div class="toast-content">
            <strong>Conta criada!</strong>
            <span>@TempData["ContaCriada"]</span>
        </div>
    </div>
}