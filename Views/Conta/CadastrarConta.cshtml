@model lsfinan.ViewModel.ContaViewModel

@{
    ViewData["Title"] = "Nova Conta";
    Layout = "_Layout";
}

<style>
    .conta-form-page {
        max-width: 650px;
        margin: 40px auto;
        padding: 0 20px;
        color: #fff;
    }

    .form-header {
        margin-bottom: 30px;
    }

    .form-header h1 {
        font-size: 28px;
        margin-bottom: 8px;
    }

    .form-header p {
        color: #94a3b8;
    }

    .form-card {
        background: #0F172A;
        border: 1px solid #1e293b;
        border-radius: 18px;
        padding: 30px;
    }

    .form-group {
        margin-bottom: 22px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #e2e8f0;
    }

    .form-control {
        width: 100%;
        box-sizing: border-box;
        background: #070B12;
        border: 1px solid #334155;
        color: #fff;
        padding: 13px 14px;
        border-radius: 10px;
        outline: none;
        font-size: 15px;
    }

    .form-control:focus {
        border-color: #2563EB;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    .validation {
        color: #f87171;
        font-size: 13px;
        margin-top: 6px;
        display: block;
    }

    .form-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 30px;
        gap: 15px;
    }

    .btn-primary {
        background: #2563EB;
        color: white;
        border: none;
        padding: 13px 22px;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: 0.2s;
    }

    .btn-primary:hover {
        background: #3B82F6;
    }

    .btn-secondary {
        background: transparent;
        color: #94a3b8;
        border: 1px solid #334155;
        padding: 12px 20px;
        border-radius: 10px;
        text-decoration: none;
        transition: 0.2s;
    }

    .btn-secondary:hover {
        color: #fff;
        border-color: #64748b;
    }

    .error-summary {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #f87171;
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    @@media (max-width: 600px) {
        .form-card {
            padding: 22px;
        }

        .form-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .btn-primary,
        .btn-secondary {
            text-align: center;
        }
    }
</style>

<div class="conta-form-page">

    <div class="form-header">
        <h1>Nova conta</h1>
        <p>Cadastre uma conta para começar a controlar suas movimentações.</p>
    </div>

    <div class="form-card">

        <div asp-validation-summary="ModelOnly" class="error-summary"></div>

        <form asp-action="CadastrarConta" method="post">

            <div class="form-group">

                <label asp-for="NomeConta">
                    Nome da conta
                </label>

                <input asp-for="NomeConta"
                       class="form-control"
                       placeholder="Ex: Nubank, Banco do Brasil, Carteira..."
                       autocomplete="off" />

                <span asp-validation-for="NomeConta"
                      class="validation"></span>

            </div>

            <div class="form-group">

                <label asp-for="SaldoInicial">
                    Saldo inicial
                </label>

                <input asp-for="SaldoInicial"
                       class="form-control"
                       type="number"
                       step="0.01"
                       min="0"
                       placeholder="0,00" />

                <span asp-validation-for="SaldoInicial"
                      class="validation"></span>

            </div>

            <div class="form-group">

                <label asp-for="TipoConta">
                    Tipo da conta
                </label>

                <select asp-for="TipoConta"
                        asp-items="Html.GetEnumSelectList<lsfinan.Enum.EnumTipoConta>()"
                        class="form-control">

                    <option value="">
                        Selecione o tipo da conta
                    </option>

                </select>

                <span asp-validation-for="TipoConta"
                      class="validation"></span>

            </div>

            <div class="form-actions">

                <a asp-action="Index" class="btn-secondary">
                    Cancelar
                </a>

                <button type="submit" class="btn-primary">
                    Cadastrar conta
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}