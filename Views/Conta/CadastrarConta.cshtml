@model lsfinan.ViewModel.ContaViewModel

@{
    var edicao = Model.Id > 0;
    ViewData["Title"] = edicao ? "Editar Conta" : "Nova Conta";
    Layout = "_Layout";
}

<style>
    .conta-form-page {
        max-width: 650px;
        margin: 40px auto;
        padding: 0 20px;
        color: #0f172a;
    }

    .form-header {
        margin-bottom: 30px;
    }

    .form-header h1 {
        font-size: 28px;
        margin-bottom: 8px;
    }

    .form-header p {
        color: #64748b;
    }

    .form-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 30px;
    }

    .form-group {
        margin-bottom: 22px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #1e293b;
    }

    .form-control {
        width: 100%;
        box-sizing: border-box;
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        color: #0f172a;
        padding: 13px 14px;
        border-radius: 10px;
        outline: none;
        font-size: 15px;
    }

    .form-control:focus {
        border-color: #1d4380;
        box-shadow: 0 0 0 3px rgba(15, 37, 71, 0.105);
    }

    .validation {
        color: #dc2626;
        font-size: 13px;
        margin-top: 6px;
        display: block;
    }

    .form-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 30px;
        gap: 15px;
    }

    .btn-primary {
        background: #0f2547;
        color: #ffffff;
        border: none;
        padding: 13px 22px;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: 0.2s;
    }

    .btn-primary:hover {
        background: #173a73;
    }

    .btn-secondary {
        background: transparent;
        color: #64748b;
        border: 1px solid #cbd5e1;
        padding: 12px 20px;
        border-radius: 10px;
        text-decoration: none;
        transition: 0.2s;
    }

    .btn-secondary:hover {
        color: #0f172a;
        border-color: #94a3b8;
    }

    .error-summary {
        background: rgba(220, 38, 38, 0.1);
        border: 1px solid rgba(220, 38, 38, 0.3);
        color: #dc2626;
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    @@media (max-width: 600px) {
        .form-card {
            padding: 22px;
        }

        .form-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .btn-primary,
        .btn-secondary {
            text-align: center;
        }
    }

    .conta-ativa {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 14px 16px;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #f8fafc;
        cursor: pointer;
    }

    .conta-ativa input {
        margin-top: 4px;
        width: 18px;
        height: 18px;
        accent-color: #0f2547;
    }

    .conta-ativa strong {
        display: block;
        color: #0f172a;
        font-size: 14px;
    }

    .conta-ativa small {
        color: #64748b;
        font-size: 13px;
    }
</style>

<div class="conta-form-page">

    <div class="form-header">
        <h1>@(edicao ? "Editar conta" : "Nova conta")</h1>
        <p>
            @(edicao
                ? "Altere os dados da conta. Contas inativas não aceitam novas movimentações, mas o histórico continua."
                : "Cadastre uma conta para começar a controlar suas movimentações.")
        </p>
    </div>

    <div class="form-card">

        <div asp-validation-summary="ModelOnly" class="error-summary"></div>

        <form asp-action="@(edicao ? "EditarConta" : "CadastrarConta")"
              asp-route-id="@(edicao ? Model.Id.ToString() : null)"
              method="post">

            <div class="form-group">

                <label asp-for="NomeConta">
                    Nome da conta
                </label>

                <input asp-for="NomeConta"
                       class="form-control"
                       placeholder="Ex: Nubank, Banco do Brasil, Carteira..."
                       autocomplete="off" />

                <span asp-validation-for="NomeConta"
                      class="validation"></span>

            </div>

            <div class="form-group">

                <label asp-for="SaldoInicial">
                    Saldo inicial
                </label>

                <input asp-for="SaldoInicial"
                       class="form-control"
                       type="number"
                       step="0.01"
                       min="0"
                       placeholder="0,00" />

                <span asp-validation-for="SaldoInicial"
                      class="validation"></span>

            </div>

            <div class="form-group">

                <label asp-for="TipoConta">
                    Tipo da conta
                </label>

                <select asp-for="TipoConta"
                        asp-items="Html.GetEnumSelectList<lsfinan.Enum.EnumTipoConta>()"
                        class="form-control">

                    <option value="">
                        Selecione o tipo da conta
                    </option>

                </select>

                <span asp-validation-for="TipoConta"
                      class="validation"></span>

            </div>

            <div class="form-group">
                <label class="conta-ativa">
                    <input asp-for="Ativa" />
                    <span>
                        <strong>Conta ativa</strong>
                        <small>Só contas ativas aparecem ao cadastrar entradas, saídas e pagamentos.</small>
                    </span>
                </label>
            </div>

            <div class="form-actions">

                <a asp-action="Index" class="btn-secondary">
                    Cancelar
                </a>

                <button type="submit" class="btn-primary">
                    @(edicao ? "Salvar alterações" : "Cadastrar conta")
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}