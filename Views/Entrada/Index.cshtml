@model List<lsfinan.Models.Entrada>

@{
    ViewData["Title"] = "Entradas";
    Layout = "_Layout";
}

<style>
    .entrada-container {
        padding: 30px;
        color: #0f172a;
    }

    .entrada-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .entrada-header h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 600;
    }

    .entrada-header p {
        margin: 6px 0 0;
        color: #64748b;
        font-size: 14px;
    }

    .btn-nova-entrada {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 18px;
        background: #0f2547;
        color: #ffffff;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 500;
        transition: 0.2s;
    }

    .btn-nova-entrada:hover {
        background: #173a73;
        color: #ffffff;
    }

    .entradas-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
    }

    .entrada-tabela {
        width: 100%;
        border-collapse: collapse;
    }

    .entrada-tabela thead {
        background: #f8fafc;
    }

    .entrada-tabela th {
        padding: 16px;
        text-align: left;
        color: #64748b;
        font-size: 13px;
        font-weight: 500;
        border-bottom: 1px solid #e2e8f0;
    }

    .entrada-tabela td {
        padding: 16px;
        border-bottom: 1px solid #e2e8f0;
        color: #1e293b;
        font-size: 14px;
    }

    .entrada-tabela tbody tr {
        transition: 0.2s;
    }

    .entrada-tabela tbody tr:hover {
        background: #f8fafc;
    }

    .entrada-nome {
        font-weight: 500;
        color: #0f172a;
    }

    .entrada-valor {
        color: #1d4380;
        font-weight: 600;
    }

    .entrada-data {
        color: #64748b;
    }

    .entrada-vazia {
        text-align: center;
        padding: 60px 20px;
    }

    .entrada-vazia h3 {
        margin-bottom: 8px;
        color: #0f172a;
    }

    .entrada-vazia p {
        color: #64748b;
        margin-bottom: 20px;
    }

    .acoes {
        display: flex;
        gap: 8px;
    }

    .btn-acao {
        padding: 7px 12px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 13px;
        border: 1px solid #cbd5e1;
        color: #334155;
        transition: 0.2s;
    }

    .btn-acao:hover {
        background: #eef2f7;
        color: #0f172a;
    }

    @@media (max-width: 768px) {

        .entrada-container {
            padding: 20px;
        }

        .entrada-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .entradas-card {
            overflow-x: auto;
        }

        .entrada-tabela {
            min-width: 650px;
        }
    }

    /* botões de ação que são <button> dentro de formulário (excluir) */
    .form-inline-acao {
        display: inline;
        margin: 0;
    }

    button.btn-acao {
        font-family: inherit;
        cursor: pointer;
        background: #ffffff;
        line-height: normal;
    }

    button.btn-acao:hover {
        background: #eef2f7;
    }
</style>

<div class="entrada-container">

    <div class="entrada-header">

        <div>
            <h1>Entradas</h1>
            <p>Gerencie todas as suas receitas financeiras.</p>
        </div>

        <a asp-controller="Entrada"
           asp-action="CadastrarEntrada"
           class="btn-nova-entrada">
            + Nova entrada
        </a>

    </div>

    <div class="entradas-card">

        @if (Model != null && Model.Any())
        {
            <table class="entrada-tabela">

                <thead>
                    <tr>
                        <th>Descrição</th>
                        <th>Valor</th>
                        <th>Data</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var entrada in Model)
                    {
                        <tr>

                            <td>
                                <span class="entrada-nome">
                                    @entrada.DescricaoEntrada
                                </span>
                            </td>

                            <td>
                                <span class="entrada-valor">
                                    R$ @entrada.ValorEntrada.ToString("N2")
                                </span>
                            </td>

                            <td>
                                <span class="entrada-data">
                                    @entrada.DataEntrada.ToString("dd/MM/yyyy")
                                </span>
                            </td>
                            

                            <td>

                                <div class="acoes">

                                    <a asp-action="EditarEntrada"
                                       asp-route-id="@entrada.Id"
                                       class="btn-acao">
                                        Editar
                                    </a>

                                    <form asp-action="ExcluirEntrada"
                                          asp-route-id="@entrada.Id"
                                          method="post"
                                          class="form-inline-acao"
                                          data-confirmar="Excluir a entrada &quot;@entrada.DescricaoEntrada&quot;? Isso não pode ser desfeito."
                                          onsubmit="return confirm(this.dataset.confirmar)">
                                        <button type="submit" class="btn-acao">
                                            Excluir
                                        </button>
                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }
        else
        {
            <div class="entrada-vazia">

                <h3>Nenhuma entrada encontrada</h3>

                <p>
                    Você ainda não cadastrou nenhuma entrada financeira.
                </p>

                <a asp-controller="Entrada"
                   asp-action="CadastrarEntrada"
                   class="btn-nova-entrada">
                    + Cadastrar primeira entrada
                </a>

            </div>
        }

    </div>

</div>