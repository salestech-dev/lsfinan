@model EntradaViewModel
@{
    var edicao = Model.Id > 0;
    ViewData["Title"] = edicao ? "Editar Entrada" : "Cadastrar Entrada";
    Layout = "_Layout";
}

<div class="entrada-container">

    <div class="entrada-header">
        <h1>@(edicao ? "Editar Entrada" : "Cadastrar Entrada")</h1>
        <p>@(edicao ? "Altere os dados da entrada. A data original é mantida." : "Registre uma nova entrada financeira.")</p>
    </div>

    <form asp-controller="Entrada"
          asp-action="@(edicao ? "EditarEntrada" : "CadastrarEntrada")"
          asp-route-id="@(edicao ? Model.Id.ToString() : null)"
          method="post"
          class="entrada-form">

        <div asp-validation-summary="ModelOnly" class="entrada-erro"></div>

        <div class="form-group">
            <label asp-for="DescricaoEntrada">Descrição</label>
            <input asp-for="DescricaoEntrada" type="text"
                   placeholder="Ex: Salário, Freelance, Venda..." autocomplete="off" />
            <span asp-validation-for="DescricaoEntrada" class="entrada-erro"></span>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="ValorEntrada">Valor</label>
                <input asp-for="ValorEntrada" type="number" step="0.01" min="0" placeholder="0,00" />
                <span asp-validation-for="ValorEntrada" class="entrada-erro"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="CategoriaId">Categoria</label>
            <select asp-for="CategoriaId">
                <option value="">Selecione uma categoria</option>
                @foreach (var categoria in Model.Categorias)
                {
                    <option value="@categoria.Id">
                        @categoria.NomeCategoria@(categoria.Ativa ? "" : " (inativa)")
                    </option>
                }
            </select>
            <span asp-validation-for="CategoriaId" class="entrada-erro"></span>
        </div>

        <div class="form-group">
            <label asp-for="ContaId">Conta</label>
            <select asp-for="ContaId">
                <option value="">Selecione uma conta</option>
                @foreach (var conta in Model.Contas)
                {
                    <option value="@conta.Id">
                        @conta.NomeConta@(conta.Ativa ? "" : " (inativa)")
                    </option>
                }
            </select>
            <span asp-validation-for="ContaId" class="entrada-erro"></span>
        </div>

        <div class="form-actions">
            <a asp-controller="Entrada" asp-action="Index" class="btn-secondary">
                Cancelar
            </a>

            <button type="submit" class="btn-primary">
                @(edicao ? "Salvar alterações" : "Cadastrar Entrada")
            </button>
        </div>

    </form>

</div>

<style>
    .entrada-container {
        max-width: 850px;
        margin: 40px auto;
        padding: 30px;
        background: #ffffff;
        border-radius: 18px;
        color: #0f172a;
    }

    .entrada-header {
        margin-bottom: 30px;
    }

    .entrada-header h1 {
        margin: 0;
        font-size: 30px;
    }

    .entrada-header p {
        margin-top: 8px;
        color: #64748b;
    }

    .entrada-form {
        display: flex;
        flex-direction: column;
        gap: 22px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .form-group label {
        font-weight: 600;
        color: #1e293b;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
        width: 100%;
        box-sizing: border-box;
        padding: 13px 15px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #f8fafc;
        color: #0f172a;
        outline: none;
        font-size: 15px;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        border-color: #1d4380;
        box-shadow: 0 0 0 2px rgba(15, 37, 71, 0.105);
    }

    .form-group textarea {
        resize: vertical;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 10px;
    }

    .btn-primary,
    .btn-secondary {
        padding: 12px 22px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        border: none;
        font-size: 15px;
    }

    .btn-primary {
        background: #0f2547;
        color: #ffffff;
    }

    .btn-primary:hover {
        background: #173a73;
    }

    .btn-secondary {
        background: #eef2f7;
        color: #334155;
    }

    .btn-secondary:hover {
        background: #e2e8f0;
    }

    .validation {
        color: #dc2626;
    }

    .form-group span {
        color: #dc2626;
        font-size: 13px;
    }

    @@media (max-width: 700px) {

        .entrada-container {
            margin: 20px;
            padding: 20px;
        }

        .form-row {
            grid-template-columns: 1fr;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn-primary,
        .btn-secondary {
            width: 100%;
            text-align: center;
        }
    }

    .entrada-erro {
        display: block;
        color: #dc2626;
        font-size: 13px;
        margin-top: 6px;
    }

    div.entrada-erro ul {
        margin: 0 0 14px;
        padding: 12px 14px 12px 30px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 12px;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}