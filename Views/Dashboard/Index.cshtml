@using lsfinan.ViewModel
@model DashboardViewModel

@{
    Layout = "_Layout";

    var mostrarBoasVindas = TempData["MostrarBoasVindas"] != null;
}

<style>

    :root {
        --blue: #0F2547;
        --blue-light: #173A73;
        --blue-soft: #1D4380;

        /* Paleta clara: branco acinzentado + azul marinho */
        --background: #F4F6F9;
        --surface: #FFFFFF;
        --surface-light: #F8FAFC;

        --border: #E2E8F0;

        --text: #0F172A;
        --muted: #64748B;

        --balance: #0F2547;
        --income: #0D7A55;
        --expense: #DC2626;
    }


    /* =====================================================
       DASHBOARD
       ===================================================== */

    .dashboard-page {
        min-height: 100vh;
        padding: 35px;

        background: var(--background);

        color: var(--text);
    }


    /* =====================================================
       HEADER
       ===================================================== */

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;

        margin-bottom: 35px;
    }

    .dashboard-title h1 {
        margin: 0;

        font-size: 30px;
        font-weight: 700;
        letter-spacing: -1px;
    }

    .dashboard-title p {
        margin: 8px 0 0;

        color: var(--muted);
        font-size: 14px;
    }

    .dashboard-title span {
        color: var(--blue-soft);
    }


    /* =====================================================
       CARDS
       ===================================================== */

    .cards-grid {
        display: grid;

        grid-template-columns:
            repeat(4, 1fr);

        gap: 20px;

        margin-bottom: 30px;
    }

    .dashboard-card {
        position: relative;

        padding: 25px;

        min-height: 150px;

        background:
            linear-gradient(
                145deg,
                #ffffff,
                #ffffff
            );

        border: 1px solid var(--border);

        border-radius: 18px;

        overflow: hidden;

        transition:
            transform 0.25s ease,
            border-color 0.25s ease,
            box-shadow 0.25s ease;
    }

    .dashboard-card::before {
        content: "";

        position: absolute;

        width: 150px;
        height: 150px;

        border-radius: 50%;

        background: rgba(100, 116, 139, 0.032);

        filter: blur(35px);

        top: -80px;
        right: -60px;
    }

    .dashboard-card:hover {
        transform: translateY(-4px);

        border-color: #cbd5e1;

        box-shadow: 0 14px 32px rgba(15, 23, 42, 0.045);
    }


    /* =====================================================
       CARD HEADER
       ===================================================== */

    .card-header-custom {
        display: flex;
        align-items: center;
        justify-content: space-between;

        margin-bottom: 20px;
    }

    .card-label {
        color: var(--muted);

        font-size: 13px;
        font-weight: 500;
    }

    .card-icon {
        width: 38px;
        height: 38px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 10px;

        background: rgba(15, 37, 71, 0.072);

        border: 1px solid rgba(100, 116, 139, 0.18);

        color: var(--blue-soft);

        font-size: 16px;
    }


    /* =====================================================
       VALORES
       ===================================================== */

    .card-value {
        font-size: 27px;

        font-weight: 700;

        letter-spacing: -0.7px;
    }

    .card-value.blue {
        color: var(--balance);
    }

    .card-value.green {
        color: var(--income);
    }

    .card-value.red {
        color: var(--expense);
    }


    /* =====================================================
       ÁREA INFERIOR
       ===================================================== */

    .dashboard-bottom {
        display: grid;

        grid-template-columns:
            1fr 320px;

        gap: 20px;
    }


    /* =====================================================
       MOVIMENTAÇÕES
       ===================================================== */

    .movements-card {
        background: #ffffff;

        border: 1px solid var(--border);

        border-radius: 18px;

        padding: 25px;

        min-height: 350px;
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;

        margin-bottom: 25px;
    }

    .section-header h2 {
        margin: 0;

        font-size: 18px;
        font-weight: 600;
    }

    .section-header button {
        border: none;

        background: transparent;

        color: var(--blue-soft);

        font-size: 13px;

        cursor: pointer;
    }

    .empty-state {
        min-height: 250px;

        display: flex;

        flex-direction: column;

        align-items: center;

        justify-content: center;

        text-align: center;
    }

    .empty-icon {
        width: 60px;
        height: 60px;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background: rgba(100, 116, 139, 0.063);

        color: #64748b;

        font-size: 25px;

        margin-bottom: 15px;
    }

    .empty-state h3 {
        margin: 0 0 7px;

        font-size: 16px;
    }

    .empty-state p {
        margin: 0;

        color: var(--muted);

        font-size: 13px;
    }


    /* =====================================================
       RESULTADO
       ===================================================== */

    .result-card {
        position: relative;

        padding: 28px;

        background:
            linear-gradient(
                145deg,
                #ffffff,
                #ffffff
            );

        border: 1px solid var(--border);

        border-radius: 18px;

        overflow: hidden;
    }

    .result-card::after {
        content: "";

        position: absolute;

        width: 180px;
        height: 180px;

        border-radius: 50%;

        background:
            rgba(15, 37, 71, 0.041);

        filter: blur(45px);

        right: -90px;
        bottom: -90px;
    }

    .result-card h3 {
        position: relative;

        z-index: 2;

        margin: 0 0 10px;

        color: var(--muted);

        font-size: 14px;

        font-weight: 500;
    }

    .result-value {
        position: relative;

        z-index: 2;

        font-size: 32px;

        font-weight: 700;

        color: var(--balance);
    }

    .result-description {
        position: relative;

        z-index: 2;

        margin-top: 15px;

        color: var(--muted);

        font-size: 13px;

        line-height: 1.6;
    }


    /* =====================================================
       ANIMAÇÃO DE BOAS-VINDAS
       ===================================================== */

    .welcome-screen {
        position: fixed;

        inset: 0;

        z-index: 99999;

        display: flex;

        align-items: center;
        justify-content: center;

        overflow: hidden;

        background: #0a1a33;

        pointer-events: none;

        animation:
            welcomeScreenExit 3.4s ease forwards;

        color: #f8fafc;
    }


    /*
       CAMADA PRINCIPAL DO LÍQUIDO
    */

    .welcome-screen::before {
        content: "";

        position: absolute;

        width: 180%;
        height: 180%;

        left: -40%;
        top: -40%;

        background:
            radial-gradient(
                ellipse at center,
                #3f6fb8 0%,
                #2d5ba3 20%,
                #1d4380 42%,
                #173a73 60%,
                #0f2547 85%
            );

        border-radius: 48% 52% 55% 45%;

        filter: blur(5px);

        transform: scale(0);

        animation:
            welcomeLiquidEnter
            2.2s
            cubic-bezier(.65, 0, .35, 1)
            forwards;
    }


    /*
       BRILHO DO LÍQUIDO
    */

    .welcome-screen::after {
        content: "";

        position: absolute;

        width: 140%;
        height: 140%;

        left: -20%;
        top: -20%;

        background:
            radial-gradient(
                circle at center,
                rgba(150, 178, 225, 0.95) 0%,
                rgba(63, 111, 184, 0.6) 25%,
                rgba(29, 67, 128, 0.25) 45%,
                transparent 70%
            );

        filter: blur(45px);

        opacity: 0;

        transform: scale(0.2);

        animation:
            welcomeGlow
            2.4s
            ease-out
            forwards;
    }


    /* =====================================================
       TEXTO
       ===================================================== */

    .welcome-content {
        position: relative;

        z-index: 10;

        text-align: center;

        opacity: 0;

        transform:
            translateY(25px)
            scale(0.90);

        animation:
            welcomeText
            3s
            ease
            forwards;
    }

    .welcome-content h1 {
        margin: 0;

        color: #ffffff;

        font-size: 46px;

        font-weight: 700;

        letter-spacing: -1.5px;

        text-shadow:
            0 0 30px
            rgba(255, 255, 255, 0.25);
    }

    .welcome-content h1 span {
        color: #e6edf8;

        text-shadow:
            0 0 35px
            rgba(150, 178, 225, 0.75);
    }

    .welcome-content p {
        margin-top: 14px;

        color: #f1f5fb;

        font-size: 19px;

        opacity: 0.95;
    }


    /* =====================================================
       ANIMAÇÕES
       ===================================================== */

    @@keyframes welcomeLiquidEnter {

        0% {
            transform:
                scale(0)
                rotate(-20deg);

            border-radius:
                50%;
        }

        35% {
            transform:
                scale(0.55)
                rotate(8deg);

            border-radius:
                55% 45% 50% 50%;
        }

        65% {
            transform:
                scale(1.05)
                rotate(-4deg);

            border-radius:
                42% 58% 55% 45%;
        }

        100% {
            transform:
                scale(1)
                rotate(0deg);

            border-radius:
                48% 52% 50% 50%;
        }
    }


    @@keyframes welcomeGlow {

        0% {
            opacity: 0;

            transform:
                scale(0.2);
        }

        30% {
            opacity: 1;

            transform:
                scale(0.65);
        }

        65% {
            opacity: 0.8;

            transform:
                scale(1);
        }

        100% {
            opacity: 0;

            transform:
                scale(1.2);
        }
    }


    @@keyframes welcomeText {

        0% {
            opacity: 0;

            transform:
                translateY(25px)
                scale(0.90);
        }

        22% {
            opacity: 1;

            transform:
                translateY(0)
                scale(1);
        }

        72% {
            opacity: 1;

            transform:
                translateY(0)
                scale(1);
        }

        100% {
            opacity: 0;

            transform:
                translateY(-15px)
                scale(1.03);
        }
    }


    /*
       AQUI ESTÁ A CORREÇÃO PRINCIPAL.

       A tela inteira desaparece no final.
       Assim o azul NÃO fica preso sobre o Dashboard.
    */

    @@keyframes welcomeScreenExit {

        0% {
            opacity: 1;

            visibility: visible;
        }

        72% {
            opacity: 1;

            visibility: visible;
        }

        88% {
            opacity: 0;

            visibility: visible;
        }

        100% {
            opacity: 0;

            visibility: hidden;
        }
    }


    /* =====================================================
       RESPONSIVIDADE
       ===================================================== */

    @@media (max-width: 1100px) {

        .cards-grid {
            grid-template-columns:
                repeat(2, 1fr);
        }

        .dashboard-bottom {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 700px) {

        .dashboard-page {
            padding: 20px;
        }

        .dashboard-header {
            align-items: flex-start;

            flex-direction: column;

            gap: 15px;
        }

        .cards-grid {
            grid-template-columns: 1fr;
        }

        .welcome-content {
            width: 90%;
        }

        .welcome-content h1 {
            font-size: 32px;
        }

        .welcome-content p {
            font-size: 16px;
        }
    }

    /* ---- aviso de contas a pagar no topo ---- */
    .dash-aviso {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 18px;
        margin-bottom: 22px;
        border-radius: 16px;
        background: #fffbeb;
        border: 1px solid #fde68a;
        color: #92400e;
        text-decoration: none;
        transition: box-shadow .15s;
    }

    .dash-aviso:hover { box-shadow: 0 8px 24px rgba(15, 23, 42, .08); color: #92400e; }

    .dash-aviso-atraso { background: #fef2f2; border-color: #fecaca; color: #b91c1c; }
    .dash-aviso-atraso:hover { color: #b91c1c; }

    .dash-aviso-icone {
        flex: none;
        width: 36px;
        height: 36px;
        border-radius: 11px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 18px;
        color: #fff;
        background: #d97706;
    }

    .dash-aviso-atraso .dash-aviso-icone { background: #dc2626; }

    .dash-aviso strong { display: block; font-size: 15px; }
    .dash-aviso span.dash-aviso-texto { font-size: 13px; opacity: .9; }
    .dash-aviso-link { margin-left: auto; font-size: 13px; font-weight: 700; white-space: nowrap; }

    /* ---- últimas movimentações ---- */
    .mov-lista { display: flex; flex-direction: column; }

    .mov-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 0;
        border-bottom: 1px solid #e2e8f0;
    }

    .mov-item:last-child { border-bottom: 0; }

    .mov-icone {
        flex: none;
        width: 38px;
        height: 38px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        background: #f1f5f9;
        color: #334155;
    }

    .mov-icone.entrada { background: #f0fdf4; color: #15803d; }
    .mov-icone.saida { background: #fef2f2; color: #dc2626; }

    .mov-info { flex: 1; min-width: 0; }
    .mov-info strong { display: block; font-size: 15px; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mov-info small { color: #64748b; font-size: 12px; }

    .mov-valor { font-weight: 700; font-size: 15px; white-space: nowrap; }
    .mov-valor.entrada { color: #0d7a55; }
    .mov-valor.saida { color: #dc2626; }

    /* ---- coluna da direita ---- */
    .dashboard-side { display: flex; flex-direction: column; gap: 20px; }

    .venc-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 24px;
    }

    .venc-card h3 { margin: 0 0 14px; font-size: 17px; color: #0f172a; }

    .venc-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding: 10px 0;
        border-bottom: 1px solid #e2e8f0;
    }

    .venc-item:last-of-type { border-bottom: 0; }
    .venc-item strong { display: block; font-size: 14px; color: #0f172a; margin-bottom: 4px; }
    .venc-item .venc-valor { font-weight: 700; font-size: 14px; color: #0f172a; white-space: nowrap; }

    .venc-vazio { color: #64748b; font-size: 14px; line-height: 1.5; margin: 0 0 12px; }

    .venc-link { display: inline-block; margin-top: 10px; font-size: 13px; font-weight: 700; color: #1d4380; text-decoration: none; }
    .venc-link:hover { text-decoration: underline; }
</style>


@* =====================================================
   BOAS-VINDAS
   ===================================================== *@

@if (mostrarBoasVindas)
{
    <div class="welcome-screen">

        <div class="welcome-content">

            <h1>
                Bem-vindo,
                <span>@Model.NomeUsuario!</span>
            </h1>

            <p>
                Vamos cuidar das suas finanças.
            </p>

        </div>

    </div>
}


@* =====================================================
   DASHBOARD
   ===================================================== *@

<div class="dashboard-page">


    @* AVISO DE CONTAS A PAGAR (atrasadas / vencendo) *@
    @if (Model.Alertas != null && Model.Alertas.TemAlerta)
    {
        var alerta = Model.Alertas;
        var textos = new List<string>();

        if (alerta.QtdAtrasadas > 0)
        {
            textos.Add($"{alerta.QtdAtrasadas} {(alerta.QtdAtrasadas == 1 ? "conta atrasada" : "contas atrasadas")}");
        }

        if (alerta.QtdHoje > 0)
        {
            textos.Add($"{alerta.QtdHoje} {(alerta.QtdHoje == 1 ? "vence hoje" : "vencem hoje")}");
        }

        if (alerta.QtdProximos > 0)
        {
            textos.Add($"{alerta.QtdProximos} {(alerta.QtdProximos == 1 ? "vence" : "vencem")} nos próximos {alerta.JanelaDias} dias");
        }

        <a asp-controller="ContaPagar" asp-action="Index"
           class="dash-aviso @(alerta.TemAtraso ? "dash-aviso-atraso" : "")">
            <span class="dash-aviso-icone">!</span>
            <div>
                <strong>@(alerta.TemAtraso ? "Você tem contas atrasadas" : "Contas para pagar em breve")</strong>
                <span class="dash-aviso-texto">@string.Join(" · ", textos)</span>
            </div>
            <span class="dash-aviso-link">Ver contas →</span>
        </a>
    }

    @* HEADER *@

    <header class="dashboard-header">

        <div class="dashboard-title">

            <h1>
                Olá,
                <span>@Model.NomeUsuario</span>
            </h1>

            <p>
                Aqui está um resumo das suas finanças.
            </p>

        </div>

    </header>


    @* =================================================
       CARDS
       ================================================= *@

    <section class="cards-grid">


        @* SALDO *@

        <div class="dashboard-card">

            <div class="card-header-custom">

                <span class="card-label">
                    Saldo total
                </span>

                <div class="card-icon">
                    $
                </div>

            </div>

            <div class="card-value blue">

                R$ @Model.SaldoTotal.ToString("N2")

            </div>

        </div>


        @* ENTRADAS *@

        <div class="dashboard-card">

            <div class="card-header-custom">

                <span class="card-label">
                    Entradas
                </span>

                <div class="card-icon">
                    ↑
                </div>

            </div>

            <div class="card-value green">

                R$ @Model.TotalEntradas.ToString("N2")

            </div>

        </div>


        @* SAÍDAS *@

        <div class="dashboard-card">    

            <div class="card-header-custom">

                <span class="card-label">
                    Saídas
                </span>

                <div class="card-icon">
                    ↓
                </div>

            </div>

            <div class="card-value red">

                R$ @Model.TotalSaidas.ToString("N2")

            </div>

        </div>


        @* RESULTADO *@

        <div class="dashboard-card">

            <div class="card-header-custom">

                <span class="card-label">
                    Resultado
                </span>

                <div class="card-icon">
                    =
                </div>

            </div>

            <div class="card-value blue">

                R$ @Model.Resultado.ToString("N2")

            </div>

        </div>


    </section>


    @* =================================================
       PARTE INFERIOR
       ================================================= *@

    <section class="dashboard-bottom">


        @* MOVIMENTAÇÕES *@

        <div class="movements-card">

            <div class="section-header">

                <h2>
                    Últimas movimentações
                </h2>

                <button type="button" onclick="location.href='@Url.Action("TodasSaidas", "Saida")'">
                    Ver saídas
                </button>

            </div>


            @if (Model.UltimasMovimentacoes == null ||
                 !Model.UltimasMovimentacoes.Any())
            {

                <div class="empty-state">

                    <div class="empty-icon">
                        $
                    </div>

                    <h3>
                        Nenhuma movimentação ainda
                    </h3>

                    <p>
                        Quando você registrar uma entrada
                        ou saída, ela aparecerá aqui.
                    </p>

                </div>

            }
            else
            {

                <div class="mov-lista">
                    @foreach (var movimentacao in Model.UltimasMovimentacoes)
                    {
                        var entrada = movimentacao.Tipo == "Entrada";

                        <div class="mov-item">
                            <span class="mov-icone @(entrada ? "entrada" : "saida")">@(entrada ? "↑" : "↓")</span>

                            <div class="mov-info">
                                <strong>@movimentacao.Descricao</strong>
                                <small>
                                    @movimentacao.Data.ToString("dd/MM 'às' HH:mm")
                                    @if (!string.IsNullOrEmpty(movimentacao.Conta))
                                    {
                                        <text> · @movimentacao.Conta</text>
                                    }
                                </small>
                            </div>

                            <span class="mov-valor @(entrada ? "entrada" : "saida")">
                                @(entrada ? "+" : "-") @movimentacao.Valor.ToString("C2")
                            </span>
                        </div>
                    }
                </div>

            }

        </div>


        <div class="dashboard-side">
        @* RESULTADO *@
        <div class="result-card">

            <h3>
                Resultado atual
            </h3>

            <div class="result-value">

                R$ @Model.Resultado.ToString("N2")

            </div>

            <div class="result-description">

                Diferença entre tudo que foi recebido
                e tudo que foi pago.
            </div>
        </div>

        @* PRÓXIMOS VENCIMENTOS *@
        <div class="venc-card">
            <h3>Contas a pagar</h3>

            @if (Model.Alertas == null || !Model.Alertas.TemAlerta)
            {
                <p class="venc-vazio">
                    Nenhuma conta atrasada ou vencendo nos próximos
                    @(Model.Alertas?.JanelaDias ?? 7) dias.
                </p>
            }
            else
            {
                foreach (var item in Model.Alertas.Itens)
                {
                    var chip = item.Status == lsfinan.Enum.EnumStatusContaPagar.Atrasada ? "cp-chip-atrasada"
                             : item.Status == lsfinan.Enum.EnumStatusContaPagar.VenceHoje ? "cp-chip-hoje"
                             : "cp-chip-breve";

                    <div class="venc-item">
                        <div>
                            <strong>@item.Nome</strong>
                            <span class="cp-chip @chip">@item.TextoVencimento</span>
                        </div>
                        <span class="venc-valor">@item.Valor.ToString("C2")</span>
                    </div>
                }
            }

            <a asp-controller="ContaPagar" asp-action="Index" class="venc-link">Ver todas as contas a pagar →</a>
        </div>
        </div>


    </section>


</div>