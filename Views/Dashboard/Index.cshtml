@using lsfinan.ViewModel
@model DashboardViewModel

@{
    Layout = "_Layout";

    var mostrarBoasVindas = TempData["MostrarBoasVindas"] != null;
}

<style>

    :root {
        --blue: #2563EB;
        --blue-light: #3B82F6;
        --blue-soft: #60A5FA;

        --background: #070B12;
        --surface: #0F172A;
        --surface-light: #111827;

        --border: #1E293B;

        --text: #F8FAFC;
        --muted: #94A3B8;
    }


    /* =====================================================
       DASHBOARD
       ===================================================== */

    .dashboard-page {
        min-height: 100vh;
        padding: 35px;

        background:
            radial-gradient(
                circle at 10% 10%,
                rgba(37, 99, 235, 0.10),
                transparent 25%
            ),
            radial-gradient(
                circle at 90% 90%,
                rgba(59, 130, 246, 0.07),
                transparent 30%
            ),
            var(--background);

        color: var(--text);
    }


    /* =====================================================
       HEADER
       ===================================================== */

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;

        margin-bottom: 35px;
    }

    .dashboard-title h1 {
        margin: 0;

        font-size: 30px;
        font-weight: 700;
        letter-spacing: -1px;
    }

    .dashboard-title p {
        margin: 8px 0 0;

        color: var(--muted);
        font-size: 14px;
    }

    .dashboard-title span {
        color: var(--blue-soft);
    }


    /* =====================================================
       CARDS
       ===================================================== */

    .cards-grid {
        display: grid;

        grid-template-columns:
            repeat(4, 1fr);

        gap: 20px;

        margin-bottom: 30px;
    }

    .dashboard-card {
        position: relative;

        padding: 25px;

        min-height: 150px;

        background:
            linear-gradient(
                145deg,
                rgba(17, 24, 39, 0.95),
                rgba(15, 23, 42, 0.95)
            );

        border: 1px solid var(--border);

        border-radius: 18px;

        overflow: hidden;

        transition:
            transform 0.25s ease,
            border-color 0.25s ease,
            box-shadow 0.25s ease;
    }

    .dashboard-card::before {
        content: "";

        position: absolute;

        width: 150px;
        height: 150px;

        border-radius: 50%;

        background: rgba(37, 99, 235, 0.08);

        filter: blur(35px);

        top: -80px;
        right: -60px;
    }

    .dashboard-card:hover {
        transform: translateY(-4px);

        border-color:
            rgba(59, 130, 246, 0.40);

        box-shadow:
            0 15px 40px rgba(0, 0, 0, 0.25),
            0 0 25px rgba(37, 99, 235, 0.08);
    }


    /* =====================================================
       CARD HEADER
       ===================================================== */

    .card-header-custom {
        display: flex;
        align-items: center;
        justify-content: space-between;

        margin-bottom: 20px;
    }

    .card-label {
        color: var(--muted);

        font-size: 13px;
        font-weight: 500;
    }

    .card-icon {
        width: 38px;
        height: 38px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 10px;

        background:
            rgba(37, 99, 235, 0.12);

        border:
            1px solid rgba(59, 130, 246, 0.20);

        color: var(--blue-soft);

        font-size: 16px;
    }


    /* =====================================================
       VALORES
       ===================================================== */

    .card-value {
        font-size: 27px;

        font-weight: 700;

        letter-spacing: -0.7px;
    }

    .card-value.blue {
        color: var(--blue-soft);
    }

    .card-value.green {
        color: #34D399;
    }

    .card-value.red {
        color: #F87171;
    }


    /* =====================================================
       ÁREA INFERIOR
       ===================================================== */

    .dashboard-bottom {
        display: grid;

        grid-template-columns:
            1fr 320px;

        gap: 20px;
    }


    /* =====================================================
       MOVIMENTAÇÕES
       ===================================================== */

    .movements-card {
        background:
            rgba(15, 23, 42, 0.85);

        border:
            1px solid var(--border);

        border-radius: 18px;

        padding: 25px;

        min-height: 350px;
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;

        margin-bottom: 25px;
    }

    .section-header h2 {
        margin: 0;

        font-size: 18px;
        font-weight: 600;
    }

    .section-header button {
        border: none;

        background: transparent;

        color: var(--blue-soft);

        font-size: 13px;

        cursor: pointer;
    }

    .empty-state {
        min-height: 250px;

        display: flex;

        flex-direction: column;

        align-items: center;

        justify-content: center;

        text-align: center;
    }

    .empty-icon {
        width: 60px;
        height: 60px;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background:
            rgba(37, 99, 235, 0.10);

        color: var(--blue-soft);

        font-size: 25px;

        margin-bottom: 15px;
    }

    .empty-state h3 {
        margin: 0 0 7px;

        font-size: 16px;
    }

    .empty-state p {
        margin: 0;

        color: var(--muted);

        font-size: 13px;
    }


    /* =====================================================
       RESULTADO
       ===================================================== */

    .result-card {
        position: relative;

        padding: 28px;

        background:
            linear-gradient(
                145deg,
                #0F172A,
                #0B1220
            );

        border:
            1px solid rgba(59, 130, 246, 0.20);

        border-radius: 18px;

        overflow: hidden;
    }

    .result-card::after {
        content: "";

        position: absolute;

        width: 180px;
        height: 180px;

        border-radius: 50%;

        background:
            rgba(37, 99, 235, 0.10);

        filter: blur(45px);

        right: -90px;
        bottom: -90px;
    }

    .result-card h3 {
        position: relative;

        z-index: 2;

        margin: 0 0 10px;

        color: var(--muted);

        font-size: 14px;

        font-weight: 500;
    }

    .result-value {
        position: relative;

        z-index: 2;

        font-size: 32px;

        font-weight: 700;

        color: var(--blue-soft);
    }

    .result-description {
        position: relative;

        z-index: 2;

        margin-top: 15px;

        color: var(--muted);

        font-size: 13px;

        line-height: 1.6;
    }


    /* =====================================================
       ANIMAÇÃO DE BOAS-VINDAS
       ===================================================== */

    .welcome-screen {
        position: fixed;

        inset: 0;

        z-index: 99999;

        display: flex;

        align-items: center;
        justify-content: center;

        overflow: hidden;

        background: #070B12;

        pointer-events: none;

        animation:
            welcomeScreenExit 3.4s ease forwards;
    }


    /*
       CAMADA PRINCIPAL DO LÍQUIDO
    */

    .welcome-screen::before {
        content: "";

        position: absolute;

        width: 180%;
        height: 180%;

        left: -40%;
        top: -40%;

        background:
            radial-gradient(
                ellipse at center,
                #60A5FA 0%,
                #3B82F6 20%,
                #2563EB 42%,
                #1D4ED8 60%,
                #0F172A 85%
            );

        border-radius: 48% 52% 55% 45%;

        filter: blur(5px);

        transform: scale(0);

        animation:
            welcomeLiquidEnter
            2.2s
            cubic-bezier(.65, 0, .35, 1)
            forwards;
    }


    /*
       BRILHO DO LÍQUIDO
    */

    .welcome-screen::after {
        content: "";

        position: absolute;

        width: 140%;
        height: 140%;

        left: -20%;
        top: -20%;

        background:
            radial-gradient(
                circle at center,
                rgba(147, 197, 253, 0.95) 0%,
                rgba(96, 165, 250, 0.60) 25%,
                rgba(37, 99, 235, 0.25) 45%,
                transparent 70%
            );

        filter: blur(45px);

        opacity: 0;

        transform: scale(0.2);

        animation:
            welcomeGlow
            2.4s
            ease-out
            forwards;
    }


    /* =====================================================
       TEXTO
       ===================================================== */

    .welcome-content {
        position: relative;

        z-index: 10;

        text-align: center;

        opacity: 0;

        transform:
            translateY(25px)
            scale(0.90);

        animation:
            welcomeText
            3s
            ease
            forwards;
    }

    .welcome-content h1 {
        margin: 0;

        color: #FFFFFF;

        font-size: 46px;

        font-weight: 700;

        letter-spacing: -1.5px;

        text-shadow:
            0 0 30px
            rgba(255, 255, 255, 0.25);
    }

    .welcome-content h1 span {
        color: #DBEAFE;

        text-shadow:
            0 0 35px
            rgba(147, 197, 253, 0.75);
    }

    .welcome-content p {
        margin-top: 14px;

        color: #EFF6FF;

        font-size: 19px;

        opacity: 0.95;
    }


    /* =====================================================
       ANIMAÇÕES
       ===================================================== */

    @@keyframes welcomeLiquidEnter {

        0% {
            transform:
                scale(0)
                rotate(-20deg);

            border-radius:
                50%;
        }

        35% {
            transform:
                scale(0.55)
                rotate(8deg);

            border-radius:
                55% 45% 50% 50%;
        }

        65% {
            transform:
                scale(1.05)
                rotate(-4deg);

            border-radius:
                42% 58% 55% 45%;
        }

        100% {
            transform:
                scale(1)
                rotate(0deg);

            border-radius:
                48% 52% 50% 50%;
        }
    }


    @@keyframes welcomeGlow {

        0% {
            opacity: 0;

            transform:
                scale(0.2);
        }

        30% {
            opacity: 1;

            transform:
                scale(0.65);
        }

        65% {
            opacity: 0.8;

            transform:
                scale(1);
        }

        100% {
            opacity: 0;

            transform:
                scale(1.2);
        }
    }


    @@keyframes welcomeText {

        0% {
            opacity: 0;

            transform:
                translateY(25px)
                scale(0.90);
        }

        22% {
            opacity: 1;

            transform:
                translateY(0)
                scale(1);
        }

        72% {
            opacity: 1;

            transform:
                translateY(0)
                scale(1);
        }

        100% {
            opacity: 0;

            transform:
                translateY(-15px)
                scale(1.03);
        }
    }


    /*
       AQUI ESTÁ A CORREÇÃO PRINCIPAL.

       A tela inteira desaparece no final.
       Assim o azul NÃO fica preso sobre o Dashboard.
    */

    @@keyframes welcomeScreenExit {

        0% {
            opacity: 1;

            visibility: visible;
        }

        72% {
            opacity: 1;

            visibility: visible;
        }

        88% {
            opacity: 0;

            visibility: visible;
        }

        100% {
            opacity: 0;

            visibility: hidden;
        }
    }


    /* =====================================================
       RESPONSIVIDADE
       ===================================================== */

    @@media (max-width: 1100px) {

        .cards-grid {
            grid-template-columns:
                repeat(2, 1fr);
        }

        .dashboard-bottom {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 700px) {

        .dashboard-page {
            padding: 20px;
        }

        .dashboard-header {
            align-items: flex-start;

            flex-direction: column;

            gap: 15px;
        }

        .cards-grid {
            grid-template-columns: 1fr;
        }

        .welcome-content {
            width: 90%;
        }

        .welcome-content h1 {
            font-size: 32px;
        }

        .welcome-content p {
            font-size: 16px;
        }
    }

</style>


@* =====================================================
   BOAS-VINDAS
   ===================================================== *@

@if (mostrarBoasVindas)
{
    <div class="welcome-screen">

        <div class="welcome-content">

            <h1>
                Bem-vindo,
                <span>@Model.NomeUsuario!</span>
            </h1>

            <p>
                Vamos cuidar das suas finanças.
            </p>

        </div>

    </div>
}


@* =====================================================
   DASHBOARD
   ===================================================== *@

<div class="dashboard-page">


    @* HEADER *@

    <header class="dashboard-header">

        <div class="dashboard-title">

            <h1>
                Olá,
                <span>@Model.NomeUsuario</span>
            </h1>

            <p>
                Aqui está um resumo das suas finanças.
            </p>

        </div>

    </header>


    @* =================================================
       CARDS
       ================================================= *@

    <section class="cards-grid">


        @* SALDO *@

        <div class="dashboard-card">

            <div class="card-header-custom">

                <span class="card-label">
                    Saldo total
                </span>

                <div class="card-icon">
                    $
                </div>

            </div>

            <div class="card-value blue">

                R$ @Model.SaldoTotal.ToString("N2")

            </div>

        </div>


        @* ENTRADAS *@

        <div class="dashboard-card">

            <div class="card-header-custom">

                <span class="card-label">
                    Entradas
                </span>

                <div class="card-icon">
                    ↑
                </div>

            </div>

            <div class="card-value green">

                R$ @Model.TotalEntradas.ToString("N2")

            </div>

        </div>


        @* SAÍDAS *@

        <div class="dashboard-card">

            <div class="card-header-custom">

                <span class="card-label">
                    Saídas
                </span>

                <div class="card-icon">
                    ↓
                </div>

            </div>

            <div class="card-value red">

                R$ @Model.TotalSaidas.ToString("N2")

            </div>

        </div>


        @* RESULTADO *@

        <div class="dashboard-card">

            <div class="card-header-custom">

                <span class="card-label">
                    Resultado
                </span>

                <div class="card-icon">
                    =
                </div>

            </div>

            <div class="card-value blue">

                R$ @Model.Resultado.ToString("N2")

            </div>

        </div>


    </section>


    @* =================================================
       PARTE INFERIOR
       ================================================= *@

    <section class="dashboard-bottom">


        @* MOVIMENTAÇÕES *@

        <div class="movements-card">

            <div class="section-header">

                <h2>
                    Últimas movimentações
                </h2>

                <button type="button">
                    Ver todas
                </button>

            </div>


            @if (Model.UltimasMovimentacoes == null ||
                 !Model.UltimasMovimentacoes.Any())
            {

                <div class="empty-state">

                    <div class="empty-icon">
                        $
                    </div>

                    <h3>
                        Nenhuma movimentação ainda
                    </h3>

                    <p>
                        Quando você registrar uma entrada
                        ou saída, ela aparecerá aqui.
                    </p>

                </div>

            }
            else
            {

                <div>

                    @foreach (var movimentacao in Model.UltimasMovimentacoes)
                    {

                        <div>
                            @* 
                               As movimentações serão estilizadas
                               quando o ViewModel delas estiver completo.
                            *@
                        </div>

                    }

                </div>

            }

        </div>


        @* RESULTADO *@

        <div class="result-card">

            <h3>
                Resultado atual
            </h3>

            <div class="result-value">

                R$ @Model.Resultado.ToString("N2")

            </div>

            <div class="result-description">

                Diferença entre tudo que foi recebido
                e tudo que foi pago.

            </div>

        </div>


    </section>


</div>