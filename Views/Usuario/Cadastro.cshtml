@using lsfinan.ViewModel
@model UsuarioCadastroViewModel

@{
    ViewData["Title"] = "Criar conta";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        min-height: 100vh;
        font-family: "Inter", "Segoe UI", Arial, sans-serif;
        background: #0B0F19;
        color: #F1F5F9;
    }

    .register-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px 20px;
    }

    .register-container {
        width: 100%;
        max-width: 1050px;
        min-height: 650px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: #111827;
        border: 1px solid #1F2937;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 25px 80px rgba(0, 0, 0, 0.45);
    }

    /* =========================
       LADO ESQUERDO
       ========================= */

    .register-brand {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 55px;
        background: #080C14;
        color: #F8FAFC;
        overflow: hidden;
        border-right: 1px solid #1F2937;
    }

    .register-brand::before {
        content: "";
        position: absolute;
        width: 420px;
        height: 420px;
        border-radius: 50%;
        background: rgba(59, 130, 246, 0.08);
        top: -180px;
        right: -180px;
    }

    .register-brand::after {
        content: "";
        position: absolute;
        width: 320px;
        height: 320px;
        border-radius: 50%;
        background: rgba(59, 130, 246, 0.05);
        bottom: -160px;
        left: -120px;
    }

    .brand-content {
        position: relative;
        z-index: 2;
    }

    .brand-logo {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 70px;
    }

    .brand-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #172554;
        border: 1px solid #1E40AF;
        color: #60A5FA;
        font-size: 21px;
        font-weight: 700;
    }

    .brand-name {
        font-size: 23px;
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .brand-content h1 {
        max-width: 430px;
        margin: 0 0 20px;
        font-size: 40px;
        line-height: 1.12;
        letter-spacing: -1.5px;
    }

    .brand-content p {
        max-width: 410px;
        margin: 0;
        color: #94A3B8;
        font-size: 16px;
        line-height: 1.7;
    }

    .brand-features {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .feature {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #CBD5E1;
        font-size: 14px;
    }

    .feature-check {
        width: 27px;
        height: 27px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #172554;
        border: 1px solid #1E40AF;
        color: #60A5FA;
        font-size: 13px;
    }

    /* =========================
       FORMULÁRIO
       ========================= */

    .register-form-area {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 55px;
        background: #111827;
    }

    .register-form {
        width: 100%;
        max-width: 390px;
    }

    .form-header {
        margin-bottom: 30px;
    }

    .form-header h2 {
        margin: 0 0 10px;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: -0.8px;
        color: #F8FAFC;
    }

    .form-header p {
        margin: 0;
        color: #94A3B8;
        font-size: 14px;
        line-height: 1.6;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-size: 14px;
        font-weight: 600;
        color: #CBD5E1;
    }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #64748B;
        font-size: 16px;
        pointer-events: none;
    }

    .form-control-custom {
        width: 100%;
        height: 50px;
        padding: 0 15px 0 45px;
        border: 1px solid #263244;
        border-radius: 11px;
        outline: none;
        background: #0F172A;
        color: #F1F5F9;
        font-size: 14px;
        transition: all 0.2s ease;
    }

    .form-control-custom::placeholder {
        color: #64748B;
    }

    .form-control-custom:hover {
        border-color: #334155;
    }

    .form-control-custom:focus {
        border-color: #3B82F6;
        background: #0F172A;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12);
    }

    .validation-message {
        display: block;
        margin-top: 6px;
        color: #F87171;
        font-size: 12px;
    }

    .validation-summary {
        margin-bottom: 20px;
        padding: 12px 15px;
        border-radius: 10px;
        background: #2A1115;
        border: 1px solid #7F1D1D;
        color: #FCA5A5;
        font-size: 13px;
    }

    .register-button {
        width: 100%;
        height: 52px;
        margin-top: 5px;
        border: none;
        border-radius: 11px;
        background: #2563EB;
        color: #FFFFFF;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 8px 25px rgba(37, 99, 235, 0.25);
    }

    .register-button:hover {
        background: #1D4ED8;
        transform: translateY(-1px);
        box-shadow: 0 12px 30px rgba(37, 99, 235, 0.35);
    }

    .register-button:active {
        transform: translateY(0);
    }

    .login-area {
        margin-top: 25px;
        padding-top: 22px;
        border-top: 1px solid #1F2937;
        text-align: center;
        color: #64748B;
        font-size: 14px;
    }

    .login-link {
        color: #60A5FA;
        font-weight: 600;
        text-decoration: none;
    }

    .login-link:hover {
        color: #93C5FD;
        text-decoration: underline;
    }

    /* =========================
       RESPONSIVIDADE
       ========================= */

    @@media (max-width: 850px) {

        .register-container {
            grid-template-columns: 1fr;
            max-width: 500px;
        }

        .register-brand {
            min-height: 320px;
            padding: 40px;
            border-right: none;
            border-bottom: 1px solid #1F2937;
        }

        .brand-logo {
            margin-bottom: 40px;
        }

        .brand-content h1 {
            font-size: 32px;
        }

        .brand-features {
            display: none;
        }

        .register-form-area {
            padding: 45px 35px;
        }
    }

    @@media (max-width: 500px) {

        .register-page {
            padding: 0;
        }

        .register-container {
            min-height: 100vh;
            border-radius: 0;
            border: none;
            box-shadow: none;
        }

        .register-brand {
            min-height: 280px;
            padding: 30px 25px;
        }

        .register-form-area {
            padding: 35px 25px;
        }

        .form-header h2 {
            font-size: 26px;
        }
    }
</style>

<div class="register-page">

    <div class="register-container">

        <section class="register-brand">

            <div class="brand-content">

                <div class="brand-logo">

                    <div class="brand-icon">
                        $
                    </div>

                    <span class="brand-name">
                        LS Finan
                    </span>

                </div>

                <h1>
                    Comece a cuidar melhor do seu dinheiro.
                </h1>

                <p>
                    Crie sua conta e tenha uma visão mais clara
                    das suas entradas, saídas e contas.
                </p>

            </div>

            <div class="brand-features">

                <div class="feature">
                    <span class="feature-check">✓</span>
                    Organize suas contas
                </div>

                <div class="feature">
                    <span class="feature-check">✓</span>
                    Controle suas entradas e saídas
                </div>

                <div class="feature">
                    <span class="feature-check">✓</span>
                    Acompanhe sua vida financeira
                </div>

            </div>

        </section>


        <section class="register-form-area">

            <div class="register-form">

                <div class="form-header">

                    <h2>
                        Criar sua conta
                    </h2>

                    <p>
                        Preencha seus dados para começar.
                    </p>

                </div>

                @* <div asp-validation-summary="All"
                     class="validation-summary">
                </div> *@

                <form asp-action="Cadastro" method="post">

                    <div class="form-group">

                        <label asp-for="Nome">
                            Nome
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">

                            </span>

                            <input asp-for="Nome"
                                   class="form-control-custom"
                                   placeholder="Digite seu nome" />

                        </div>

                        <span asp-validation-for="Nome"
                              class="validation-message">
                        </span>

                    </div>


                    <div class="form-group">

                        <label asp-for="Email">
                            E-mail
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">
                                
                            </span>

                            <input asp-for="Email"
                                   class="form-control-custom"
                                   placeholder="seuemail@exemplo.com" />

                        </div>

                        <span asp-validation-for="Email"
                              class="validation-message">
                        </span>

                    </div>


                    <div class="form-group">

                        <label asp-for="Senha">
                            Senha
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">
                                
                            </span>

                            <input asp-for="Senha"
                                   type="password"
                                   class="form-control-custom"
                                   placeholder="Digite sua senha" />

                        </div>

                        <span asp-validation-for="Senha"
                              class="validation-message">
                        </span>

                    </div>


                    <div class="form-group">

                        <label asp-for="ConfirmarSenha">
                            Confirmar senha
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">
                                
                            </span>

                            <input asp-for="ConfirmarSenha"
                                   type="password"
                                   class="form-control-custom"
                                   placeholder="Digite sua senha novamente" />

                        </div>

                        <span asp-validation-for="ConfirmarSenha"
                              class="validation-message">
                        </span>

                    </div>


                    <button type="submit" class="register-button">
                        Criar minha conta
                    </button>

                </form>

                <div class="login-area">

                    Já possui uma conta?

                    <a asp-controller="Usuario"
                       asp-action="Login"
                       class="login-link">
                        Entrar
                    </a>

                </div>

            </div>

        </section>

    </div>

</div>