
@model lsfinan.ViewModel.VerificarEmailViewModel

@{
    ViewData["Title"] = "Confirmar e-mail";
    Layout = "_LayoutLogin";
}

<div class="container">
    <h2>Confirme seu e-mail</h2>

    <p>Enviamos um código de seis dígitos para:</p>

    <strong>@Model.Email</strong>

    <form asp-controller="Usuario"
          asp-action="VerificarEmail"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Email" />

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Codigo">Código de confirmação</label>

            <input asp-for="Codigo"
                   class="form-control"
                   maxlength="6"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   placeholder="000000" />

            <span asp-validation-for="Codigo"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Confirmar e-mail
        </button>
    </form>

    <form asp-controller="Usuario"
          asp-action="ReenviarCodigo"
          method="post"
          class="mt-3">

        @Html.AntiForgeryToken()

        <input type="hidden" name="email" value="@Model.Email" />

        <button type="submit" class="btn btn-outline-secondary">
            Enviar código novamente
        </button>
    </form>
</div>
